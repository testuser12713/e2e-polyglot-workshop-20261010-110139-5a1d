# Copy to .env (docker compose reads it) or export these in your shell before
# starting the API. The office generates the secrets per run; a human cloning
# the repository must choose their own values here. No secret is filled in.

# Password of the local PostgreSQL container started by compose.yaml (required).
POSTGRES_PASSWORD=

# User and database of the local PostgreSQL container (defaults from compose.yaml).
POSTGRES_USER=app
POSTGRES_DB=app

# Address of the PostgreSQL 18 database. Replace <password> with POSTGRES_PASSWORD.
DATABASE_URL=postgresql://app:<password>@localhost:5432/app

# Address of the Valkey 9.1 instance used as the invoice queue (see compose.yaml).
VALKEY_URL=redis://localhost:6379/0

# Name of the Valkey list the API pushes completed orders onto. Default: workshop:invoices.
QUEUE_NAME=workshop:invoices

# Port the API listens on.
HTTP_PORT=8000

# Signing key for the login tokens. Generate one, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# E-mail of the employee seeded on first start.
SEED_EMPLOYEE_EMAIL=chef@workshop.local

# Start password of the seeded employee. Generate one, e.g. `openssl rand -hex 16`.
SEED_EMPLOYEE_PASSWORD=

# Origin of the web app allowed by CORS.
CORS_ORIGIN=http://localhost:5173
